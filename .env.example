DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

BETTER_AUTH_SECRET=

BETTER_AUTH_URL=http://localhost:3000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Vercel AI Gateway (create at vercel.com → AI Gateway → API Keys)
# https://vercel.com/docs/ai-gateway/authentication-and-byok/api-keys
AI_GATEWAY_API_KEY=
# Google AI Studio key (AQ.* or AIza*) — use this OR a Gateway key, not both in the wrong slot
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional; defaults to google/gemini-2.5-flash
AI_CHAT_MODEL=
