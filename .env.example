DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

BETTER_AUTH_SECRET=

BETTER_AUTH_URL=http://localhost:3000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Chat LLM provider: together (default) | google | gateway
AI_CHAT_PROVIDER=together

# Together.ai — https://api.together.xyz/settings/api-keys
TOGETHER_API_KEY=

# Google Generative AI (disabled unless AI_CHAT_PROVIDER=google)
# Google AI Studio key (AQ.* or AIza*)
GOOGLE_GENERATIVE_AI_API_KEY=

# Vercel AI Gateway (only when AI_CHAT_PROVIDER=gateway)
# https://vercel.com/docs/ai-gateway/authentication-and-byok/api-keys
AI_GATEWAY_API_KEY=

# Optional model override. Defaults: Qwen/Qwen3.5-9B (together) or google/gemini-2.5-flash (google/gateway)
AI_CHAT_MODEL=

# Cron job secret for /api/cron/inactivity (set any random string)
# Then configure an external cron service to hit GET /api/cron/inactivity
# with Authorization: Bearer <CRON_SECRET> every 30 minutes
CRON_SECRET=
